{
    "version": 1,
    "meta": {
        "name": "High contrast",
        "description": "Black and white surfaces, strong borders and large focus rings."
    },
    "mode": {
        "default": "system",
        "allowToggle": true
    },
    "color": {
        "dark": {
            "canvas": "#000000",
            "surfaceSunken": "#000000",
            "surface": "#0A0A0A",
            "surfaceRaised": "#161616",
            "border": "#8A8A8A",
            "text": "#FFFFFF",
            "textMuted": "#E0E0E0",
            "accent": "#FFD43B",
            "accentSecondary": "#FFD43B",
            "accentText": "#FFD43B",
            "accentContrast": "#000000",
            "success": "#7CFF8A",
            "warning": "#FFD43B",
            "danger": "#FF8A80",
            "info": "#9CD3FF",
            "focus": "#FFD43B"
        },
        "light": {
            "canvas": "#FFFFFF",
            "surfaceSunken": "#FFFFFF",
            "surface": "#FFFFFF",
            "surfaceRaised": "#F2F2F2",
            "border": "#4A4A4A",
            "text": "#000000",
            "textMuted": "#262626",
            "accent": "#0033A0",
            "accentSecondary": "#0033A0",
            "accentText": "#0033A0",
            "accentContrast": "#FFFFFF",
            "success": "#00662A",
            "warning": "#7A3E00",
            "danger": "#A30010",
            "info": "#0033A0",
            "focus": "#0033A0"
        }
    },
    "typography": {
        "display": "Sora",
        "body": "Sora",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
        "stylesheet": "",
        "scale": 1,
        "headingWeight": 600
    },
    "radius": {
        "base": 6
    },
    "spacing": {
        "base": 4
    },
    "density": "comfortable",
    "elevation": {
        "shadow": "none",
        "borders": true
    },
    "layout": {
        "sidebar": "flush",
        "sidebarWidth": 280,
        "indicator": "bar",
        "contentWidth": "full",
        "backgroundGlow": false
    },
    "branding": {
        "productName": "",
        "logoDark": "",
        "logoLight": "",
        "favicon": "",
        "loginBackground": ""
    },
    "customCss": ""
}
