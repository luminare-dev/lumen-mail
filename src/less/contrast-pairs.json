{
  "$comment": "Every text/background and UI/background pair the Lumen styles set, by token role (@lm-light-<role> / @lm-dark-<role> in lumen-tokens.less). scripts/contrast.py checks each pair in light and dark mode: text needs 4.5:1 (WCAG 2.2 SC 1.4.3), UI parts (control borders, focus rings, indicators, icons) need 3:1 (SC 1.4.11). 'where' names the Elastic variables or Lumen rules that use the pair.",
  "pairs": [
    {"fg": "text", "bg": "bg", "min": 4.5, "use": "page text", "where": "body, login hero fallback"},
    {"fg": "text", "bg": "surface", "min": 4.5, "use": "text in lists, content, headers, inputs", "where": "@color-font, @color-list, @color-input"},
    {"fg": "text", "bg": "surface-raised", "min": 4.5, "use": "popovers, dialogs, login card", "where": "#login-form, .popover"},
    {"fg": "text", "bg": "surface-sunken", "min": 4.5, "use": "folder column, input add-ons, message part headers", "where": "@color-layout-sidebar-background, @color-input-addon-background"},
    {"fg": "text", "bg": "surface-hover", "min": 4.5, "use": "hovered rows and toolbar buttons", "where": "lumen.less row hover, @color-toolbar-button-background-hover"},
    {"fg": "text", "bg": "primary-tint", "min": 4.5, "use": "selected message row", "where": "@color-list-selected on @color-list-selected-background"},
    {"fg": "text", "bg": "highlight", "min": 4.5, "use": "drop target row, text selection", "where": "@color-list-droptarget-background, ::selection"},
    {"fg": "text-strong", "bg": "surface", "min": 4.5, "use": "headers, dialog titles, unread senders", "where": "@color-layout-header, @color-dialog-header"},
    {"fg": "text-2", "bg": "surface", "min": 4.5, "use": "toolbar buttons and their labels, tabs", "where": "@color-toolbar-button, .nav-tabs"},
    {"fg": "text-2", "bg": "surface-hover", "min": 4.5, "use": "hovered toolbar buttons", "where": "@color-toolbar-button-background-hover"},
    {"fg": "text-muted", "bg": "surface", "min": 4.5, "use": "dates, sizes, hints, placeholders, page navigation", "where": "@color-list-secondary, @color-form-hint, @color-input-placeholder"},
    {"fg": "text-muted", "bg": "surface-sunken", "min": 4.5, "use": "secondary text in the folder column and search field", "where": "@color-black-shade-text"},
    {"fg": "text-muted", "bg": "surface-raised", "min": 4.5, "use": "login footer, popover separators", "where": "#login-footer, @color-popover-separator"},
    {"fg": "text-muted", "bg": "primary-tint", "min": 4.5, "use": "date and sender in a selected message row", "where": "@color-list-secondary on @color-list-selected-background"},
    {"fg": "link", "bg": "surface", "min": 4.5, "use": "links in content and dialogs", "where": "@color-link, html.dark-mode a"},
    {"fg": "link", "bg": "bg", "min": 4.5, "use": "links on the page background", "where": "@color-link"},
    {"fg": "link", "bg": "surface-sunken", "min": 4.5, "use": "recent folder names, links in the folder column", "where": "@color-list-recent"},
    {"fg": "link-hover", "bg": "surface", "min": 4.5, "use": "hovered links", "where": "@color-link-hover"},
    {"fg": "on-primary", "bg": "primary", "min": 4.5, "use": "primary buttons, unread badges, date picker selection", "where": "@color-btn-primary, @color-list-badge, @color-datepicker-active"},
    {"fg": "on-primary", "bg": "primary-hover", "min": 4.5, "use": "hovered primary button", "where": "lumen.less .btn-primary:hover"},
    {"fg": "on-primary", "bg": "primary-active", "min": 4.5, "use": "pressed primary button", "where": ".btn-primary:active"},
    {"fg": "on-primary-tint", "bg": "primary-tint", "min": 4.5, "use": "selected folder or section, hovered menu item, active tab text", "where": "@color-menu-hover, lumen.less sidebar selection"},
    {"fg": "on-secondary", "bg": "secondary", "min": 4.5, "use": "secondary buttons, loading toast", "where": "@color-btn-secondary, @color-message-loading-text"},
    {"fg": "on-toast", "bg": "toast", "min": 4.5, "use": "plain toast", "where": "@color-message-text on @color-message"},
    {"fg": "on-toast-status", "bg": "toast-info", "min": 4.5, "use": "information toast", "where": "@color-message-information, @color-dark-information"},
    {"fg": "on-toast-status", "bg": "toast-success", "min": 4.5, "use": "success toast", "where": "@color-message-success, @color-dark-success"},
    {"fg": "on-toast-status", "bg": "toast-warning", "min": 4.5, "use": "warning toast", "where": "@color-message-warning, @color-dark-warning"},
    {"fg": "on-toast-status", "bg": "toast-danger", "min": 4.5, "use": "error toast, danger button in dark mode", "where": "@color-message-error, @color-dark-error, @color-dark-btn-danger-background"},
    {"fg": "info-text", "bg": "info-tint", "min": 4.5, "use": "information box", "where": "@color-message-information-box(-background)"},
    {"fg": "success-text", "bg": "success-tint", "min": 4.5, "use": "success box", "where": "@color-message-success-box(-background)"},
    {"fg": "warning-text", "bg": "warning-tint", "min": 4.5, "use": "warning box", "where": "@color-message-warning-box(-background)"},
    {"fg": "danger-text", "bg": "danger-tint", "min": 4.5, "use": "error box", "where": "@color-message-error-box(-background)"},
    {"fg": "on-danger", "bg": "danger", "min": 4.5, "use": "danger button (light mode)", "where": "@color-btn-danger"},
    {"fg": "danger", "bg": "surface", "min": 4.5, "use": "flagged message rows, field errors", "where": "@color-list-flagged, @color-error, lumen.less dark flagged rows"},
    {"fg": "success", "bg": "surface", "min": 3.0, "use": "active toolbar toggle icon", "where": ".menu.toolbar a.selected"},
    {"fg": "info-text", "bg": "surface-sunken", "min": 4.5, "use": "first quote level in messages", "where": "@color-blockquote-0, @color-dark-blockquote-0"},
    {"fg": "success-text", "bg": "surface-sunken", "min": 4.5, "use": "second quote level", "where": "@color-blockquote-1, @color-dark-blockquote-1"},
    {"fg": "danger-text", "bg": "surface-sunken", "min": 4.5, "use": "third quote level", "where": "@color-blockquote-2, @color-dark-blockquote-2"},
    {"fg": "rail-text", "bg": "rail", "min": 4.5, "use": "task menu items", "where": "@color-taskmenu-button"},
    {"fg": "rail-text-active", "bg": "rail-hover", "min": 4.5, "use": "hovered task menu item", "where": "@color-taskmenu-button-hover"},
    {"fg": "rail-text-active", "bg": "rail-active", "min": 4.5, "use": "current task", "where": "@color-taskmenu-button-selected(-background)"},
    {"fg": "rail-accent", "bg": "rail", "min": 4.5, "use": "Compose button", "where": "@color-taskmenu-button-action"},
    {"fg": "rail-accent", "bg": "rail-hover", "min": 4.5, "use": "hovered Compose button", "where": "@color-taskmenu-button-action-hover"},
    {"fg": "rail-danger", "bg": "rail", "min": 4.5, "use": "Logout", "where": "@color-taskmenu-button-logout"},
    {"fg": "rail-danger", "bg": "rail-hover", "min": 4.5, "use": "hovered Logout", "where": "@color-taskmenu-button-logout-hover"},
    {"fg": "rail-accent", "bg": "rail-active", "min": 3.0, "use": "indicator bar of the current task", "where": "lumen.less #taskmenu a.selected::after"},
    {"fg": "rail-focus", "bg": "rail", "min": 3.0, "use": "focus ring in the task menu", "where": "lumen.less #taskmenu a:focus-visible"},
    {"fg": "rail-focus", "bg": "rail-hover", "min": 3.0, "use": "focus ring on a hovered task menu item", "where": "lumen.less"},
    {"fg": "border-control", "bg": "surface", "min": 3.0, "use": "input, select and checkbox borders", "where": "@color-input-border, @color-dark-input-border"},
    {"fg": "border-control", "bg": "bg", "min": 3.0, "use": "controls on the page background", "where": "@color-input-border"},
    {"fg": "border-control", "bg": "surface-raised", "min": 3.0, "use": "inputs in dialogs and the login card", "where": "#login-form .input-group-text"},
    {"fg": "focus", "bg": "bg", "min": 3.0, "use": "focus ring on the page", "where": "lumen.less :focus-visible"},
    {"fg": "focus", "bg": "surface", "min": 3.0, "use": "focus ring in lists, content, headers; focused input border", "where": "@color-input-border-focus, @color-list-focus-indicator"},
    {"fg": "focus", "bg": "surface-raised", "min": 3.0, "use": "focus ring in dialogs and the login card", "where": "lumen.less"},
    {"fg": "focus", "bg": "surface-sunken", "min": 3.0, "use": "focus ring in the folder column, search field border", "where": "lumen.less .searchbar:focus-within"},
    {"fg": "focus", "bg": "primary-tint", "min": 3.0, "use": "focus ring on a selected row", "where": "lumen.less"},
    {"fg": "primary", "bg": "surface", "min": 3.0, "use": "unread dot, checked controls, active tab underline, quota bar", "where": "@color-list-unread-status, @color-checkbox, .nav-tabs"},
    {"fg": "scrollbar", "bg": "bg", "min": 3.0, "use": "scrollbar thumb", "where": "@color-scrollbar-thumb, @color-dark-scrollbar-thumb"}
  ]
}
