{
  "name": "lumen-mail",
  "version": "0.1.0",
  "private": true,
  "description": "A modern Luminare skin for Roundcube Webmail",
  "license": "MIT",
  "author": "Paul Pasaurek",
  "homepage": "https://github.com/luminare-dev/lumen-mail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luminare-dev/lumen-mail.git"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build:palette && npm run build:gallery",
    "build:palette": "vite build --config palette/vite.config.js && node scripts/check-palette.mjs",
    "build:gallery": "vite build --config gallery/vite.config.js",
    "gallery": "vite --config gallery/vite.config.js",
    "test": "vitest run --config palette/vitest.config.js",
    "test:js": "node --test \"tests/js/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "clean-css": "5.3.3",
    "less": "4.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
